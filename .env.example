# Sponsorship-confirmation LLM, served locally via Docker Model Runner's
# OpenAI-compatible API (see shared/visa_llm.py) -- only resolves on a
# machine actually running Docker Model Runner with this model loaded.
LLM_BASE_URL=http://localhost:12434/engines/llama.cpp/v1
LLM_MODEL=hf.co/unsloth/qwen3-4b-instruct-2507-gguf
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENTS=

DECODO_USERNAME=
DECODO_PASSWORD=

# Used for Indeed's description fetches (Indeed search stays on Selenium).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# Optional: routes Indeed's Selenium-driven *search* fetches through a
# residential proxy instead of connecting directly (see
# sources/indeed/selenium_client.py and DECISIONS.md). Leave both unset to
# connect directly -- only works then from a residential/office IP. Must
# be both set or both unset. No username/password: the proxy provider
# whitelists this machine's own outbound IP instead.
INDEED_SELENIUM_PROXY_HOST=
INDEED_SELENIUM_PROXY_PORT=

HN_LLM_CONCURRENCY=5
LINKEDIN_SEARCH_CONCURRENCY=10
LINKEDIN_DESCRIPTION_CONCURRENCY=10
LINKEDIN_LLM_CONCURRENCY=16
INDEED_SEARCH_CONCURRENCY=4
INDEED_DESCRIPTION_CONCURRENCY=4
INDEED_LLM_CONCURRENCY=16

LINKEDIN_POSTS_PER_PAGE=10
LINKEDIN_MAX_PAGES_PER_QUERY=3

INDEED_POSTS_PER_PAGE=15
INDEED_MAX_PAGES_PER_QUERY=4

# A successful page with fewer cards than this stops pagination for that
# query -- treated as the last page of real results.
INDEED_MIN_CARDS_PER_PAGE=10

# Seconds to wait after loading an Indeed search page (via Selenium) for
# its JS (including the vjk URL param it appends) to settle.
INDEED_PAGE_SETTLE_SECONDS=6

# Delay before every sequential Selenium fetch for the same Indeed
# country/query after the first (between pagination pages and between
# retry attempts). Experimental -- see DECISIONS.md.
INDEED_SEQUENTIAL_CALL_DELAY_SECONDS=2

DIGEST_RUN_TIMEOUT_SECONDS=1200
